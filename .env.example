# ==============================================================================
# MINDCARE AI PROVIDER CONFIGURATION (SERVER-SIDE ONLY - NEVER PREFIX WITH VITE_)
# ==============================================================================

# Primary AI Provider: Google Gemini
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="your_gemini_api_key_here"

# Gemini Model alias or specific identifier (Defaults to gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# Secondary / Fallback AI Provider: OpenRouter
# Obtain from OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# OpenRouter Model identifier (Defaults to anthropic/claude-3.5-haiku)
OPENROUTER_MODEL="anthropic/claude-3.5-haiku"

# ==============================================================================
# FIREBASE CLIENT CONFIGURATION
# ==============================================================================
VITE_FIREBASE_PROJECT_ID="keenkeep-live-2026"
VITE_FIREBASE_API_KEY="your_firebase_web_api_key"
VITE_FIREBASE_AUTH_DOMAIN="keenkeep-live-2026.firebaseapp.com"
VITE_FIREBASE_DATABASE_ID="(default)"
VITE_FIREBASE_STORAGE_BUCKET="keenkeep-live-2026.firebasestorage.app"
VITE_FIREBASE_APP_ID="1:504448463283:web:2172803b0fb737ee9ddbc6"
VITE_ONESIGNAL_APP_ID="your_onesignal_app_id"

# Application Hosting URL
APP_URL="http://localhost:3000"
