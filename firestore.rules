rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connectivity test collection
    match /test/{docId} {
      allow read: if true;
    }

    // 1. Users collection
    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 100 &&
             data.role in ['patient', 'caregiver'];
    }

    match /users/{uid} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(uid) && isValidUser(incoming()) && incoming().uid == request.auth.uid;
      allow update: if isSignedIn() && isValidUser(incoming());
      allow delete: if isOwner(uid);
    }

    // A signed-in user can manage only their own OneSignal external ID/device.
    match /notificationDevices/{deviceId} {
      allow get, list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if isOwner(incoming().uid) &&
        incoming().onesignalExternalId == request.auth.uid &&
        incoming().patientId is string && incoming().patientId.size() > 0 && incoming().patientId.size() <= 128 &&
        incoming().role in ['patient', 'caregiver'] &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == incoming().role &&
        ((incoming().role == 'patient' &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.patientId == incoming().patientId) ||
         (incoming().role == 'caregiver' &&
          incoming().patientId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.connectedPatientIds));
      allow delete: if isSignedIn() && existing().uid == request.auth.uid;
    }

    // 2. Patients collection
    function isValidPatient(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.caregiverId is string && data.caregiverId.size() <= 128;
    }

    match /patients/{patientId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidPatient(incoming());
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // 3. Tasks / Medications collection
    function isValidTask(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.patientId is string && data.patientId.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
             data.category in ['medicine', 'exercise', 'calm', 'meal', 'activity'];
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidTask(incoming());
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // 4. Activity Timeline
    function isValidActivity(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.patientId is string && data.patientId.size() <= 128 &&
             data.taskName is string && data.taskName.size() <= 150;
    }

    match /activities/{activityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidActivity(incoming());
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // 5. Voice Notes
    function isValidVoiceNote(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.patientId is string && data.patientId.size() <= 128 &&
             data.senderName is string && data.senderName.size() <= 100 &&
             data.senderRole in ['patient', 'caregiver'] &&
             data.transcription is string && data.transcription.size() <= 1000;
    }

    match /voiceNotes/{voiceNoteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidVoiceNote(incoming());
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // 6. SOS Alerts
    function isValidAlert(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.patientId is string && data.patientId.size() <= 128 &&
             data.status in ['active', 'resolved', 'escalated'];
    }

    match /alerts/{alertId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidAlert(incoming());
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // 7. AI Sessions (Voice Companion & Reminiscence interactions)
    function isValidAiSession(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.patientId is string && data.patientId.size() <= 128 &&
             data.language in ['en', 'kn', 'hi'];
    }

    match /aiSessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidAiSession(incoming());
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // 8. Caregiver Summaries (Grounded Daily and Weekly clinical syntheses)
    function isValidCaregiverSummary(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.patientId is string && data.patientId.size() <= 128 &&
             data.reportType in ['daily', 'weekly', 'missed', 'medication', 'mood'];
    }

    // 9. Caregiver Requests
    function isValidCaregiverRequest(data) {
      return data.requestId is string && data.requestId.size() <= 128 &&
             data.caregiverUid is string && data.caregiverUid.size() <= 128 &&
             data.patientId is string && data.patientId.size() <= 128 &&
             data.patientUid is string && data.patientUid.size() <= 128 &&
             data.status in ['pending', 'approved', 'accepted', 'rejected', 'declined'];
    }

    match /caregiverRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
                       incoming().caregiverUid == request.auth.uid &&
                       isValidCaregiverRequest(incoming());
      allow update: if isSignedIn() && isValidCaregiverRequest(incoming());
      allow delete: if isSignedIn() &&
                       (existing().caregiverUid == request.auth.uid || existing().patientUid == request.auth.uid);
    }

    // 10. Moods collection
    function isValidMood(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.patientId is string && data.patientId.size() <= 128 &&
             data.mood in ['very_happy', 'happy', 'okay', 'sad', 'anxious'];
    }

    match /moods/{moodId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidMood(incoming());
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // 12. Contacts collection
    function isValidContact(data) {
      return (data.id is string || data.contactId is string) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 50;
    }

    match /contacts/{contactId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidContact(incoming());
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}
